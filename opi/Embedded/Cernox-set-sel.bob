<?xml version="1.0" encoding="UTF-8"?>
<!--Saved on 2026-03-11 13:50:06 by konrad-->
<display version="2.0.0">
  <name>Cernox set select</name>
  <width>235</width>
  <height>240</height>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>Cavities CERNOX Selection</text>
    <x>10</x>
    <y>10</y>
    <width>220</width>
    <font>
      <font name="Header 3" family="Source Sans Pro" style="BOLD_ITALIC" size="18.0">
      </font>
    </font>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_1</name>
    <text>Used now:</text>
    <x>21</x>
    <y>40</y>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update</name>
    <pv_name>$(P):sStd</pv_name>
    <x>111</x>
    <y>40</y>
  </widget>
  <widget type="group" version="3.0.0">
    <name>  Select sensors set  </name>
    <y>70</y>
    <width>232</width>
    <height>72</height>
    <transparent>true</transparent>
    <widget type="action_button" version="3.0.0">
      <name>Action Button</name>
      <actions>
        <action type="write_pv">
          <pv_name>$(pv_name)</pv_name>
          <value>1</value>
          <description>Standard</description>
        </action>
      </actions>
      <pv_name>$(P):cmdSetStd</pv_name>
      <width>90</width>
      <tooltip>$(actions)</tooltip>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Action Button_1</name>
      <actions>
        <action type="write_pv">
          <pv_name>$(pv_name)</pv_name>
          <value>1</value>
          <description>Alternative</description>
        </action>
      </actions>
      <pv_name>$(P):cmdSetAlt</pv_name>
      <x>100</x>
      <width>90</width>
      <tooltip>$(actions)</tooltip>
    </widget>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_2</name>
    <actions execute_as_one="true">
      <action type="write_pv">
        <pv_name>CstatH-Ctrl:TT02x:cmdUpdate.PROC</pv_name>
        <value>0</value>
        <description>Update TT02x</description>
      </action>
      <action type="write_pv">
        <pv_name>CstatH-Ctrl:TT03x:cmdUpdate.PROC</pv_name>
        <value>0</value>
        <description>Update TT03x</description>
      </action>
      <action type="write_pv">
        <pv_name>CstatH-Ctrl:TT115:cmdUpdate.PROC</pv_name>
        <value>0</value>
        <description>Update TT115</description>
      </action>
      <action type="write_pv">
        <pv_name>CstatH-Ctrl:TT125:cmdUpdate.PROC</pv_name>
        <value>0</value>
        <description>Update TT125</description>
      </action>
      <action type="write_pv">
        <pv_name>CstatH-Ctrl:TT116:cmdUpdate.PROC</pv_name>
        <value>0</value>
        <description>Update TT116</description>
      </action>
      <action type="write_pv">
        <pv_name>CstatH-Ctrl:TT126:cmdUpdate.PROC</pv_name>
        <value>0</value>
        <description>Update TT126</description>
      </action>
    </actions>
    <text>Update calibration data read-back</text>
    <x>20</x>
    <y>140</y>
    <width>191</width>
    <height>50</height>
    <tooltip>Use only after changing the CERNOX calibration data.
Standard set must be selected.</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_3</name>
    <actions>
      <action type="write_pv">
        <pv_name>$(pv_name)</pv_name>
        <value>1</value>
        <description>Update calibration</description>
      </action>
    </actions>
    <pv_name>$(P):cmdUpdCalibr</pv_name>
    <x>20</x>
    <y>200</y>
    <width>191</width>
    <rules>
      <rule name="Enabled" prop_id="enabled" out_exp="false">
        <exp bool_exp="pvInt0">
          <value>true</value>
        </exp>
        <pv_name>$(P):sStd</pv_name>
      </rule>
    </rules>
    <tooltip>Use only after changing the CERNOX calibration data.
Standard set must be selected.</tooltip>
    <enabled>false</enabled>
    <show_confirm_dialog>true</show_confirm_dialog>
    <confirm_message>Are you sure?
The current calibration data for TT02x, TT03x, TT115, TT116, TT125 &amp; TT126 
will be used for transition Alternative -&gt; Standard set</confirm_message>
  </widget>
</display>
